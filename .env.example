# Rental Finder 26 — direct-source mode
# No Google CSE or search API key is required.

# Comma-separated public/permitted JSON, RSS or Atom rental feeds.
PUBLIC_FEED_URLS=

# Optional comma-separated rental search/listing pages that you are permitted to poll.
DIRECT_SOURCE_URLS=

# Required when DIRECT_SOURCE_URLS is used. Comma-separated hostnames only.
# Example: agent.example,lettings.example.co.uk
DIRECT_SOURCE_ALLOWED_HOSTS=

# Keep demo mode available while source connections are being configured.
ALLOW_DEMO_MODE=true

# Optional default scheduled refresh profile as JSON.
DEFAULT_REFRESH_SEARCH_JSON=

# Optional persistence. Leave blank to run without a database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
