# Rental Finder 26 — optional runtime configuration
# No Google/search-engine key and no database key are required.

# Optional comma-separated public/permitted JSON, RSS or Atom rental feeds.
PUBLIC_FEED_URLS=

# Optional comma-separated rental pages that you are permitted to poll.
DIRECT_SOURCE_URLS=

# Required when DIRECT_SOURCE_URLS is used. Hostnames only, comma-separated.
DIRECT_SOURCE_ALLOWED_HOSTS=

# Keep clearly-labelled fictional demo data available for UI testing.
ALLOW_DEMO_MODE=true

# Optional JSON override for the scheduled refresh profile.
DEFAULT_REFRESH_SEARCH_JSON=

# Set true to disable the built-in Nottinghamshire source registry.
DISABLE_BUILTIN_SOURCES=false
